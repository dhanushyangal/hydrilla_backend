# Server
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ==============================================================================
# Image generation API keys (OpenAI & Gemini used for 3D source images & edit)
# Env keys win; when unset the backend falls back to admin image keys stored in Supabase.
# ==============================================================================
IMAGE_OPENAI_API_KEY=
IMAGE_GEMINI_API_KEY=
# IMAGE_GOOGLE_API_KEY is accepted as an alias for IMAGE_GEMINI_API_KEY.

# ==============================================================================
# Water model API keys (Used for Code Sculpt / Water LLM models)
# Used when a user has not configured their own personal BYOK key in user settings.
# When unset in .env, falls back to admin Water keys in Supabase or legacy OPENAI_API_KEY.
# ==============================================================================
# WATER_OPENAI_API_KEY=
# WATER_GOOGLE_API_KEY=
# WATER_ANTHROPIC_API_KEY=
# WATER_OPENROUTER_API_KEY=
# WATER_CURSOR_API_KEY=

# Legacy / shared fallback keys
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional model overrides (defaults shown)
# OPENAI_IMAGE_MODEL_LOW=gpt-image-2.5-flare
# OPENAI_IMAGE_MODEL_HIGH=gpt-image-2.5-sunburst
# GEMINI_IMAGE_MODEL_LOW=gemini-3.1-flash-image
# GEMINI_IMAGE_MODEL_HIGH=gemini-3-pro-image
# OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI image content filter: low (default, fewer false blocks on game assets) or auto (stricter)
# OPENAI_IMAGE_MODERATION=low
# USD per 1M tokens used for the admin Usage & cost page (defaults in imageProviders/pricing.ts).
# Keys match a model name exactly or as a prefix; set this when a provider changes its prices.
# IMAGE_PRICING_JSON={"gpt-image-2.5-sunburst":{"textInput":5,"imageInput":8,"textOutput":10,"imageOutput":32}}
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Gemini keys work with either AI Studio (Gemini API) or Vertex AI express mode. By default the
# Gemini API is tried first and keys it blocks fall back to Vertex. Force one with:
# GEMINI_API_BACKEND=developer|vertex
# GEMINI_VERTEX_BASE_URL=https://aiplatform.googleapis.com/v1/publishers/google/models

# GPU VM (hydrilla_runtime, BlueFox3D image-to-3d)
HYDRILLA_GPU_API_URL=https://api.hydrilla.co
# Must match the VM's HYDRILLA_INTERNAL_API_SECRET (sent as X-Hydrilla-Internal).
# Also required for the admin GPU page (the VM refuses /admin/* without it).
HYDRILLA_INTERNAL_API_SECRET=

# Admin GPU page: GCP instance status + start/stop/reboot (optional).
# Service account JSON (raw or base64) with roles/compute.instanceAdmin.v1 on the VM.
GCP_SERVICE_ACCOUNT_KEY=
GCP_PROJECT_ID=hydrilla-486606
GCP_GPU_ZONE=asia-south1-c
GCP_GPU_INSTANCE=hydrilla

# S3 (uploads, generated images, meshes)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=hunyuan3d-outputs
S3_REGION=us-east-1
S3_PRESIGNED_URL_EXPIRY=3600
# S3_PUBLIC_BASE_URL=
# Set only if the bucket allows ACLs (e.g. public-read)
# S3_PUT_ACL=

# Water / BYOK key encryption (do not rotate once users have saved keys)
USER_API_KEYS_ENCRYPTION_SECRET=

# Job sync (local server only)
POLL_INTERVAL_MS=5000

# Payments (Dodo)
DODO_PAYMENT_API_KEY=
DODO_PAYMENT_WEBHOOK_SECRET=
DODO_PAYMENT_MODE=test

# Email (optional)
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_TOKEN=
